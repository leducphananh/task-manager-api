@baseUrl = http://localhost:8000

### 1. Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "12345678"
}

### 2. Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
    "name": "Test",
    "email": "test@example.com",
    "password": "12345678"
}
