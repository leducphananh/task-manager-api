@baseUrl = http://localhost:8000

### Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
    "name": "Test 3",
    "email": "test3@example.com",
    "password": "12345678"
}

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "email": "test2@example.com",
    "password": "12345678"
}